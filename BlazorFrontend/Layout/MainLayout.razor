@inherits LayoutComponentBase

<!--
  App shell: fixed sidebar navigation + main content area.
  Uses plain Bootstrap classes already shipped with the template.
-->
<div class="d-flex vh-100">
    <aside class="d-flex flex-column flex-shrink-0 p-3 bg-light border-end" style="width: 240px;">
        <a href="/" class="d-flex align-items-center mb-3 text-decoration-none">
            <span class="fs-4 fw-semibold">📈 Portfolio Tracker</span>
        </a>
        <NavMenu />
        <div class="mt-auto">
            @if (AuthService.CurrentUser is { } user)
            {
                <div class="small text-muted mb-2">Signed in as<br /><strong>@user.Email</strong></div>
                <button type="button" class="btn btn-outline-secondary w-100" @onclick="LogoutAsync">Sign out</button>
            }
        </div>
    </aside>

    <main class="flex-grow-1 overflow-auto p-4">
        @Body
    </main>
</div>

@code {
    [Inject] private IAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    /// <summary>Signs the user out and returns them to the login page.</summary>
    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
