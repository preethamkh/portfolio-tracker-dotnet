@page "/register"
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Create account - Portfolio Tracker</PageTitle>

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow-sm" style="width: 420px;">
        <div class="card-body p-4">
            <h1 class="h4 mb-1 text-center">📈 Portfolio Tracker</h1>
            <p class="text-muted text-center mb-4">Create your account to get started</p>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger py-2" role="alert">@_errorMessage</div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleRegisterAsync" FormName="register">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label" for="email">Email</label>
                    <InputText @bind-Value="_model.Email" id="email" class="form-control" placeholder="you@example.com" />
                    <ValidationMessage For="() => _model.Email" class="text-danger small" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="fullName">Full name (optional)</label>
                    <InputText @bind-Value="_model.FullName" id="fullName" class="form-control" placeholder="Jane Doe" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <InputText type="password" @bind-Value="_model.Password" id="password" class="form-control" />
                    <div class="form-text">At least 8 characters with upper/lowercase letters, a number and a special character.</div>
                    <ValidationMessage For="() => _model.Password" class="text-danger small" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="confirm">Confirm password</label>
                    <InputText type="password" @bind-Value="_model.ConfirmPassword" id="confirm" class="form-control" />
                    <ValidationMessage For="() => _model.ConfirmPassword" class="text-danger small" />
                </div>
                <button type="submit" class="btn btn-primary w-100" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Create account
                </button>
            </EditForm>

            <p class="text-muted text-center mt-3 mb-0 small">
                Already registered? <NavLink href="/login">Sign in</NavLink>
            </p>
        </div>
    </div>
</div>

@code {
    private RegisterModel _model = new();
    private bool _isSubmitting;
    private string? _errorMessage;

    [Inject] private IAuthService AuthService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private async Task HandleRegisterAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            await AuthService.RegisterAsync(new RegisterRequest
            {
                Email = _model.Email,
                Password = _model.Password,
                FullName = string.IsNullOrWhiteSpace(_model.FullName) ? null : _model.FullName
            });

            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>
    /// Client-side model. Password rules mirror the server's RegisterRequest
    /// validation; the ConfirmPassword check avoids frustrating typos.
    /// </summary>
    private sealed class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = string.Empty;

        public string? FullName { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Password must be at least 8 characters")]
        [System.ComponentModel.DataAnnotations.RegularExpression(
            @"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$",
            ErrorMessage = "Password needs upper/lowercase letters, a number and a special character")]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please confirm your password")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
